#N canvas 0 50 1000 700 10;
#X text 20 5 VOXEL arp clock: internal metro (while ARP is on) or the DAW transport (SYNC + playing);
#X obj 20 40 r vx-bpm;
#X obj 20 64 t b f;
#X obj 20 88 v vxbpm;
#X obj 20 112 r vx-arate;
#X obj 20 136 t b f;
#X obj 20 160 v vxarate;
#X obj 20 184 loadbang;
#X obj 20 208 expr 60000/(max(vxbpm \, 20)*if(vxarate==0 \, 1 \, if(vxarate==1 \, 2 \, if(vxarate==2 \, 3 \, if(vxarate==3 \, 4 \, if(vxarate==4 \, 6 \, 8))))));
#X obj 20 232 v vxstepms;
#X obj 280 40 r vx-arp;
#X obj 280 64 t b f;
#X obj 280 88 v vxarp;
#X obj 280 112 r vx-sing;
#X obj 280 136 t b f;
#X obj 280 160 v vxsing;
#X obj 280 184 r vx-sync;
#X obj 280 208 t b f;
#X obj 280 232 v vxsync;
#X obj 280 256 r playhead;
#X obj 280 280 route playing bpm position;
#X obj 280 304 change;
#X obj 280 328 t b f;
#X obj 280 352 v vxhostplay;
#X obj 280 376 expr if((vxarp || vxsing) && !(vxsync && vxhostplay) \, 1 \, 0);
#X obj 280 400 change;
#X obj 280 424 metro 250;
#X obj 280 448 f;
#X obj 280 472 + 1;
#X obj 600 600 outlet;
#X obj 560 40 change;
#X obj 560 64 expr if(vxsync \, \$f1 \, -1);
#X obj 560 88 moses 1;
#X obj 560 112 expr int(\$f1*10+0.5)/10;
#X obj 560 136 s vx-bpm-set;
#X obj 560 160 unpack f f f;
#X obj 560 184 expr if(vxsync && vxhostplay \, floor(\$f1*if(vxarate==0 \, 1 \, if(vxarate==1 \, 2 \, if(vxarate==2 \, 3 \, if(vxarate==3 \, 4 \, if(vxarate==4 \, 6 \, 8)))))+0.0001) \, -1);
#X obj 560 208 moses 0;
#X obj 560 232 change;
#X connect 1 0 2 0;
#X connect 2 1 3 0;
#X connect 4 0 5 0;
#X connect 5 1 6 0;
#X connect 2 0 8 0;
