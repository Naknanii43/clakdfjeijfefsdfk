#N canvas 0 50 1300 900 10;
#X text 20 5 banks: line N of banks.txt = 'Name CATEGORY key value ...' \, line N of grooves.txt = pattern. GOBLIN steals random knobs from another bank.;
#X obj 20 40 text define cgbanks;
#X obj 20 64 text define cggrooves;
#X obj 20 88 text define cgquips;
