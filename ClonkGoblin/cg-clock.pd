#N canvas 0 50 1000 800 10;
#X text 20 5 clock: internal metro (RUN) or host transport (SYNC + DAW playing). outputs absolute step counter.;
#X obj 20 40 r cg-bpm;
#X obj 20 64 t b f;
#X obj 20 88 v cgbpm;
#X obj 20 112 r cg-rate;
#X obj 20 136 t b f;
#X obj 20 160 v cgrate;
#X obj 20 184 loadbang;
#X obj 20 208 expr 60000/(max(cgbpm \, 20)*if(cgrate==0 \, 2 \, if(cgrate==1 \, 4 \, if(cgrate==2 \, 8 \, 6))));
#X obj 20 232 v cgstepms;
#X obj 260 40 r cg-run;
#X obj 260 64 t b f;
#X obj 260 88 v cgrun;
#X obj 260 112 r cg-sync;
#X obj 260 136 t b f;
#X obj 260 160 v cgsync;
#X obj 260 184 r playhead;
#X obj 260 208 route playing bpm position;
#X obj 260 232 change;
#X obj 260 256 t b f;
#X obj 260 280 v cghostplay;
#X obj 260 304 expr if(cgrun && !(cgsync && cghostplay) \, 1 \, 0);
#X obj 260 328 change;
#X obj 260 352 sel 1;
#X msg 260 376 0;
#X obj 260 400 metro 125;
#X obj 260 424 f;
#X obj 260 448 + 1;
#X obj 260 472 change;
#X obj 260 496 expr if(cgsync \, \$f1 \, -1);
#X obj 260 520 moses 1;
#X obj 260 544 expr int(\$f1*10+0.5)/10;
#X obj 260 568 s cg-bpm-set;
#X obj 520 40 unpack f f f;
#X obj 520 64 expr if(cgsync && cghostplay \, floor(\$f1*if(cgrate==0 \, 2 \, if(cgrate==1 \, 4 \, if(cgrate==2 \, 8 \, 6)))+0.0001) \, -1);
#X obj 520 88 moses 0;
#X obj 520 112 change;
#X obj 760 40 t f f;
#X obj 760 64 mod 2;
#X obj 760 88 pack f f;
#X obj 760 112 route 0 1;
#X obj 760 136 outlet;
#X obj 760 160 t b f;
#X obj 760 184 f;
#X obj 760 208 expr cgswing*cgstepms*0.5;
#X obj 760 232 delay;
#X msg 760 256 stop;
