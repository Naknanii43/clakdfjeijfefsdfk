#N canvas 0 50 1000 700 10;
#X text 20 5 FOGBANK arp clock: internal metro (while ARP is on) or the DAW transport (SYNC + playing);
#X obj 20 40 r fb-bpm;
#X obj 20 64 t b f;
#X obj 20 88 v fbbpm;
#X obj 20 112 r fb-arate;
#X obj 20 136 t b f;
#X obj 20 160 v fbarate;
#X obj 20 184 loadbang;
#X obj 20 208 expr 60000/(max(fbbpm \, 20)*if(fbarate==0 \, 1 \, if(fbarate==1 \, 2 \, if(fbarate==2 \, 3 \, if(fbarate==3 \, 4 \, if(fbarate==4 \, 6 \, 8))))));
#X obj 20 232 v fbstepms;
#X obj 280 40 r fb-arp;
#X obj 280 64 t b f;
#X obj 280 88 v fbarp;
#X obj 280 112 r fb-sync;
#X obj 280 136 t b f;
#X obj 280 160 v fbsync;
#X obj 280 184 r playhead;
#X obj 280 208 route playing bpm position;
#X obj 280 232 change;
#X obj 280 256 t b f;
#X obj 280 280 v fbhostplay;
#X obj 280 304 expr if(fbarp && !(fbsync && fbhostplay) \, 1 \, 0);
#X obj 280 328 change;
#X obj 280 352 metro 250;
#X obj 280 376 f;
#X obj 280 400 + 1;
#X obj 600 600 outlet;
#X obj 560 40 change;
#X obj 560 64 expr if(fbsync \, \$f1 \, -1);
#X obj 560 88 moses 1;
#X obj 560 112 expr int(\$f1*10+0.5)/10;
#X obj 560 136 s fb-bpm-set;
#X obj 560 160 unpack f f f;
#X obj 560 184 expr if(fbsync && fbhostplay \, floor(\$f1*if(fbarate==0 \, 1 \, if(fbarate==1 \, 2 \, if(fbarate==2 \, 3 \, if(fbarate==3 \, 4 \, if(fbarate==4 \, 6 \, 8)))))+0.0001) \, -1);
#X obj 560 208 moses 0;
#X obj 560 232 change;
#X connect 1 0 2 0;
#X connect 2 1 3 0;
#X connect 4 0 5 0;
#X connect 5 1 6 0;
#X connect 2 0 8 0;
#X connect 5 0 8 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 10 0 11 0;
#X connect 11 1 12 0;
