#N canvas 0 50 1000 700 10;
#X text 20 5 FOGBANK banks: banks.txt line = Name description lvl x key value ...;
#X obj 20 40 text define fbbanks;
#X obj 20 64 loadbang;
#X obj 20 88 t b b;
#X msg 20 112 read banks.txt;
#X msg 20 136 \; fb-bank-set 0;
#X obj 300 40 r fb-bank;
#X obj 300 64 clip 0 37;
#X obj 300 88 t f f;
#X obj 300 112 v fbbank;
#X obj 300 136 text get fbbanks;
#X obj 300 160 list split 2;
#X obj 300 184 unpack s s;
#X msg 300 208 \; fb-name-lbl label \$1;
#X msg 300 232 \; fb-desc-lbl label \$1;
#X obj 300 256 list split 2;
#X obj 300 280 list;
#X msg 300 304 \; fb-\$1-set \$2;
#X obj 600 40 r fb-prev;
#X obj 600 64 expr (fbbank-1+38)%38;
#X obj 600 88 s fb-bank-set;
#X obj 600 112 r fb-next;
#X obj 600 136 expr (fbbank+1)%38;
#X obj 600 160 s fb-bank-set;
#X obj 600 184 r fb-rand;
#X obj 600 208 expr random(0 \, 38);
#X obj 600 232 s fb-bank-set;
#X connect 2 0 3 0;
#X connect 3 1 4 0;
#X connect 4 0 1 0;
#X connect 3 0 5 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 1 9 0;
#X connect 8 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 12 1 14 0;
#X connect 11 1 15 0;
#X connect 15 1 16 0;
#X connect 16 0 15 0;
#X connect 15 0 17 0;
#X connect 18 0 19 0;
#X connect 19 0 20 0;
#X connect 21 0 22 0;
#X connect 22 0 23 0;
#X connect 24 0 25 0;
#X connect 25 0 26 0;
